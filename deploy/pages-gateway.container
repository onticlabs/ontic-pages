# The ontic-pages gateway as a Podman Quadlet unit. Install as
# /etc/containers/systemd/pages-gateway.container; `systemctl daemon-reload`
# generates pages-gateway.service. The image is built by deploy/pages.sh.
#
# It reads the bucket and writes each version's page.json, `current` and `visibility`; the files
# themselves go from the publisher's laptop straight to the bucket with presigned PUT URLs it
# hands out. It asks oauth2-proxy who a request's cookie belongs to, and checks the command
# line's tokens with ONTIC_PAGES_TOKEN_SECRET.
[Unit]
Description=ontic-pages gateway
StartLimitIntervalSec=0

[Container]
ContainerName=pages-gateway
Image=localhost/ontic-pages:latest
Pull=never
Network=pages.network
NetworkAlias=gateway
User=10003
Group=10003

# ONTIC_PAGES_BUCKET (ontic-pages), ONTIC_PAGES_ENDPOINT, ONTIC_PAGES_REGION, the optional
# ONTIC_PAGES_PREFIX (empty: pages sit at the bucket root), and AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY of a key scoped to the ontic-pages bucket that can read and write but
# not delete, and ONTIC_PAGES_TOKEN_SECRET. Written by pages.sh, mode 600 root:root, read by
# podman before the container starts.
EnvironmentFile=/etc/ontic-pages/gateway.env
Environment=TZ=Europe/Berlin

# One way in: Caddy on the host, at 127.0.0.1:8790, for the apex and every page host, and for
# its own /_tls-ask. Keep this port on loopback: /_tls-ask answers any Host but the public
# ones, and Caddy is what refuses it from outside.
PublishPort=127.0.0.1:8790:8790
Exec=gateway --host 0.0.0.0 --port 8790 --auth-url http://oauth2-proxy:4180/oauth2/auth

ReadOnly=true
DropCapability=all
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--memory=512m
StopTimeout=10

[Service]
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
