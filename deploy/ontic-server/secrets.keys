# Secret NAMES for pages, one per line; values live outside git in
# ~/.config/ontic-server/<host>/pages/secrets.env (directory 0700, file 0600).
# A name followed by "optional" may be absent or empty. Any key in the
# secrets file that is not listed here is refused.
#
# Each [file] collects the names below it into /etc/pages/current/<file> on
# the box, mode 0600. Both files are owned by root: the Quadlet files read
# them with EnvironmentFile=, which podman reads as root before the container
# starts, so no container ever reads a secrets file itself and no file needs
# another owner. (The older deploy mounted an oauth2-proxy.cfg owned by
# 65532; the flags in quadlet/pages-oauth2-proxy.container replace it.)
#
# Not here, because they are not secret: the bucket name, endpoint and
# region, the apex URL and direct delivery are Environment= lines in
# quadlet/pages-gateway.container.

# The gateway.
[gateway.env]
# A bucket key that can read and write but not delete (deploy/README.md).
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
# Signs each person's 30-day command line token; at least 32 characters.
# Changing it signs everyone out of the command line.
ONTIC_PAGES_TOKEN_SECRET
# Optional milestone sync with GitHub (github.py). Without the token there is
# no sync; with it, the owner (an email) is required.
ONTIC_PAGES_GITHUB_TOKEN optional
ONTIC_PAGES_GITHUB_REPO optional
ONTIC_PAGES_GITHUB_OWNER optional

# Google sign-in. oauth2-proxy reads these straight from its environment.
# The older deploy's secrets.env calls them GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET and OAUTH2_COOKIE_SECRET.
[oauth2-proxy.env]
OAUTH2_PROXY_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET
